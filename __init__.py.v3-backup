"""MOSS model selectors + native MOSS loader with city96 GGUF ops."""
import os
import sys
import torch
import folder_paths
import comfy.sd
import comfy.utils


def _module(attr, suffix):
    matches = [m for name, m in tuple(sys.modules.items()) if name.endswith(suffix) and callable(getattr(m, attr, None))]
    if not matches:
        raise RuntimeError(f"Required plugin module with {attr} not loaded. Install/enable official MOSS-Image and ComfyUI-GGUF.")
    return matches[0]


def _models(*cats, extension):
    found = set()
    for cat in cats:
        if cat in folder_paths.folder_names_and_paths:
            found.update(n for n in folder_paths.get_filename_list(cat) if n.lower().endswith(extension))
    return sorted(found) or ["NO_MATCHING_MODELS_FOUND"]


def _path(name, *cats):
    for cat in cats:
        if cat in folder_paths.folder_names_and_paths:
            p = folder_paths.get_full_path(cat, name)
            if p and os.path.isfile(p):
                return p
    raise FileNotFoundError(f"Model '{name}' not found in {', '.join(cats)}")


class MossGGUF:
    CATEGORY = "MOSS-Image/Rebel"
    RETURN_TYPES = ("MODEL",)
    FUNCTION = "load"

    @classmethod
    def INPUT_TYPES(cls):
        return {"required": {
            "model_name": (_models("diffusion_models", "unet", extension=(".gguf",)),),
            "compute_dtype": (["bf16", "fp32"], {"default": "bf16"}),
        }}

    def load(self, model_name, compute_dtype):
        p = _path(model_name, "diffusion_models", "unet")
        gg = _module("gguf_sd_loader", ".loader")
        moss = _module("load_model_state", ".loaders")
        ops_mod = _module("GGMLOps", ".ops") if False else None
        # GGMLOps is a class, not a callable module function; locate by attribute.
        ops_modules = [m for n, m in tuple(sys.modules.items()) if n.endswith(".ops") and hasattr(m, "GGMLOps")]
        if not ops_modules:
            raise RuntimeError("ComfyUI-GGUF operations module was not loaded")
        gg.IMG_ARCH_LIST.add("moss_image")
        state, info = gg.gguf_sd_loader(p, handle_prefix=None)
        if info.get("arch_str") != "moss_image":
            raise ValueError(f"Expected moss_image architecture, got {info.get('arch_str')!r}")
        ops = ops_modules[0].GGMLOps()
        dtype = torch.bfloat16 if compute_dtype == "bf16" else torch.float32
        ops.Linear.dequant_dtype = dtype
        model = moss.load_model_state(state, dtype, True, metadata=info.get("metadata"), model_options={"custom_operations": ops})
        return (model,)


class MossEncoder:
    CATEGORY = "MOSS-Image/Rebel"
    RETURN_TYPES = ("CLIP",)
    FUNCTION = "load"

    @classmethod
    def INPUT_TYPES(cls):
        return {"required": {
            "encoder_name": (_models("text_encoders", "clip", extension=(".safetensors", ".pt", ".bin")),),
            "device": (["default", "cpu"], {"default": "default"}),
        }}

    def load(self, encoder_name, device):
        p = _path(encoder_name, "text_encoders", "clip")
        moss = _module("load_clip", ".loaders")
        # Official MOSS load_clip returns a real CLIP, and validates Qwen3.5-9B.
        return (moss.load_clip(p, device),)


class MossVAE:
    CATEGORY = "MOSS-Image/Rebel"
    RETURN_TYPES = ("VAE",)
    FUNCTION = "load"

    @classmethod
    def INPUT_TYPES(cls):
        return {"required": {"vae_name": (_models("vae", extension=(".safetensors", ".pt")),)}}

    def load(self, vae_name):
        p = _path(vae_name, "vae")
        sd = comfy.utils.load_torch_file(p)
        return (comfy.sd.VAE(sd=sd),)


NODE_CLASS_MAPPINGS = {
    "RebelMossGGUFV3": MossGGUF,
    "RebelMossEncoderV3": MossEncoder,
    "RebelMossVAEV3": MossVAE,
}
NODE_DISPLAY_NAME_MAPPINGS = {
    "RebelMossGGUFV3": "MOSS GGUF Transformer (Rebel)",
    "RebelMossEncoderV3": "MOSS Qwen3.5 Encoder (Rebel)",
    "RebelMossVAEV3": "MOSS VAE (Rebel)",
}
